# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development

# --- Database (use DATABASE_URL OR individual vars) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# DB_SSL=true
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=biketraining
# DB_USER=postgres
# DB_PASSWORD=
DB_POOL_MAX=10

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-session-secret

# --- Google OAuth (customer sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Console "Authorized redirect URIs", e.g.:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Frontend (CORS + OAuth redirect target) ---
FRONTEND_URL=http://localhost:4200
# Optional: Vercel preview URL for CORS
# FRONTEND_URL_PREVIEW=

# --- Server ---
PORT=3000
HOST=0.0.0.0

# --- Email (optional) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# ADMIN_ALERT_EMAIL=

# --- Customer inactivity (optional cron) ---
# DISABLE_INACTIVITY_CRON=1
# INACTIVITY_CRON=0 2 * * *
# INACTIVITY_BLOCK_DAYS=45

# --- Booking window (customer advance booking ceiling, hours) ---
# Override settings.booking_window_hours. Default 168 = 7 days.
# Same-day bookings still require minAdvanceHours (5) from app.config.
# BOOKING_WINDOW_HOURS=168

# --- Nightly slot auto-generation (optional) ---
# Ensures slot grid for 7 calendar days starting today (default midnight Asia/Kolkata).
# DISABLE_AUTO_SLOT_CRON=1
# AUTO_SLOT_CRON=0 0 * * *
# AUTO_SLOT_CRON_TZ=Asia/Kolkata
# AUTO_SLOT_RUN_ON_START=1

# --- Uploads / Cloudinary (Admin CMS images) ---
# Required for gallery, blogs, courses, testimonials, branches, settings banners
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER_ROOT=kolkata-bike-training
# REQUIRE_CLOUDINARY=1
# GALLERY_IMAGE_MAX_BYTES=5242880
# BLOG_IMAGE_MAX_BYTES=5242880
# COURSE_IMAGE_MAX_BYTES=5242880
# TESTIMONIAL_IMAGE_MAX_BYTES=5242880
# BRANCH_IMAGE_MAX_BYTES=5242880
# SETTINGS_IMAGE_MAX_BYTES=5242880
# RECEIPT_MAX_BYTES=5242880
# UPLOAD_DIR=
# PENDING_PAYMENT_EXPIRE_HOURS=12
# DISABLE_PAYMENT_EXPIRE_CRON=1
# PAYMENT_EXPIRE_CRON=15 * * * *

# --- Overdue bookings (optional cron) ---
# DISABLE_OVERDUE_BOOKING_CRON=1
# OVERDUE_BOOKING_CRON=0 * * * *

# --- Startup schema/ensure toggles (optional) ---
# DISABLE_AUTO_SLOT_STARTUP=1
# AUTO_SLOT_STARTUP_DAYS=7
# DISABLE_SLOT_CAPACITY_STARTUP=1
# DISABLE_REACTIVATION_SCHEMA_STARTUP=1
# DISABLE_OFFLINE_BOOKING_SCHEMA_STARTUP=1
# ENABLE_LIVE_AUTO_SLOT_FALLBACK=1

# --- Cookies / auth extras ---
# COOKIE_SECURE=1

# --- Debug logging (leave unset in production) ---
# LOG_BOOKING_DEBUG=1
# LOG_RATE_LIMIT_DEBUG=1
# LOG_SUB_ADMINS_ROUTE=1

# --- WhatsApp (optional) ---
# WHATSAPP_PROVIDER=
# WHATSAPP_API_KEY=
# WHATSAPP_API_URL=
# ADMIN_PHONE=
